# ── Dependencias ──
node_modules/
.pnpm-store/

# El lock de las apps es el `pnpm-lock.yaml` de la raíz (el workspace se instala desde ahí con
# --frozen-lockfile). Un lock dentro de apps/ o packages/ no lo lee nadie y se queda viejo: si
# alguien instala dentro de esa carpeta, se lleva un árbol de dependencias distinto al desplegado.
# Excepción RI-25: .github/tools/updater-signer tiene un lock independiente porque el runner de
# firma no instala ni ejecuta las dependencias de la aplicación.
# Los `package-lock.json` de npm, además, están prohibidos por CLAUDE.md.
**/package-lock.json
apps/*/pnpm-lock.yaml
packages/*/pnpm-lock.yaml

# ── Salidas de build JS ──
dist/
dist-ssr/
.turbo/
*.tsbuildinfo

# ── Rust / Cargo ──
**/target/
.cargo-target/

# ── Tauri (generado) ──
apps/tpv-main/src-tauri/gen/schemas/

# ── WebView2 «fixed runtime» (descargado, ~444 MB) ──
# El runtime que se empaqueta con el instalador cuando no se quiere depender del WebView2 del
# sistema (ver docs/estudios/compatibilidad-windows-7.md). Es un artefacto que se BAJA de Microsoft, no
# código nuestro: versionarlo mete casi medio giga en el historial para siempre, y un `git add -A`
# distraído basta para hacerlo. Se obtiene del Evergreen Standalone Installer del canal que toque.
apps/tpv-main/src-tauri/webview2-fixed-runtime/

# ── Claves de firma del updater (¡SECRETO! nunca versionar la privada) ──
apps/tpv-main/src-tauri/.tauri/

# ── Bases de datos / datos locales ──
*.db
*.db-journal
*.db-wal
*.db-shm

# ── Logs ──
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Entorno ──
.env
.env.local
.env.*.local
*.local

# ── Editor / SO ──
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Cloudflare / Wrangler ──
.wrangler/
.dev.vars

# ── Backups locales de migración (no versionar) ──
_old_git_backup/

# Capturas de los fallos del E2E (TEST-01)
apps/tpv-main/e2e/fallos/

# Artefactos sueltos de ts-rs: lo bueno va a packages/contracts/src/generated/bindings.ts
crates/*/bindings/
