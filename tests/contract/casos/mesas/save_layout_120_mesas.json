{
  "descripcion": "DO-01: guardar desde la Handy un plano con 101 zonas y una zona de 120 mesas. El NOT IN de las zonas y el de las mesas conservadas ponían un parámetro por elemento: con más de 100 zonas o una zona de más de 98 mesas la nube rechazaba la sentencia. Las listas van en un solo parámetro (un array JSON). Se quitan del plano la mesa M121 (sin historia: se borra) y la zona Z102 con su mesa libre (se borran las dos); las 101 zonas y las 120 mesas conservadas siguen, con su posición nueva.",
  "comando": "mesas.save_layout",
  "seed": [
    "WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 102) INSERT INTO Zonas (ID_Zona, Nombre_Zona, Room_Points) SELECT 'zona-' || substr('000' || i, -3), 'Z' || substr('000' || i, -3), '[1.0]' FROM n;",
    "WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 121) INSERT INTO Mesas (ID_Mesa, ID_Zona, Numero_Mesa, Capacidad, Ubicacion_X, Ubicacion_Y, Shape, Width, Height) SELECT 'mesa-' || substr('000' || i, -3), 'zona-001', 'M' || substr('000' || i, -3), 4, 0, 0, 'rect', 80, 80 FROM n;",
    "INSERT INTO Mesas (ID_Mesa, ID_Zona, Numero_Mesa, Capacidad, Ubicacion_X, Ubicacion_Y, Shape, Width, Height) VALUES ('mesa-x', 'zona-102', 'X1', 4, 0, 0, 'rect', 80, 80);"
  ],
