{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // RI-22: los generados siguen en el grafo; sus exportaciones las decide Specta en Rust.
  "ignoreIssues": {
    "packages/*/src/generated/**": ["exports", "types"]
  },
  // Herramientas no gestionadas por pnpm, invocadas desde los scripts del monorepo.
  "ignoreBinaries": ["cargo", "python"],
  "workspaces": {
    ".": {
      // El test del generador de carga lo lanza quien lo toca (`node --test`), no CI.
      "entry": ["scripts/*.mjs", "scripts/carga/*.test.mjs", "eslint.config.mjs"],
      "project": ["scripts/**/*.mjs", "eslint.config.mjs"],
      // RI-25 y AUD-44: los workflows ejecutan el firmante y Wrangler desde su lockfile aislado
      // (.github/tools/*), fuera del workspace; no son dependencias que falten en la raíz.
      "ignoreBinaries": ["tauri", "wrangler"]
    },
    "apps/tpv-main": {
      "entry": ["src/app/main.tsx", "test/**/*.test.{ts,tsx}", "test/react/setup.ts", "test/**/*.types.ts", "e2e/wdio.conf.ts", "e2e/construir.ts", "e2e/specs/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "e2e/**/*.ts", "*.config.ts"],
      "webdriver-io": { "config": ["e2e/wdio.conf.ts"] },
      // Tailwind y los tokens de @tpv/estilos se importan en Global.css; WDIO carga
      // runner/servicio por configuración y sus tipos son ambientales. No son imports TS que
      // Knip pueda resolver.
      "ignoreDependencies": ["tailwindcss", "@tpv/estilos", "@wdio/local-runner", "@wdio/tauri-service", "@wdio/types"]
    },
    "apps/reservas-web": {
      // embed.js va tal cual a la web del restaurante (sale de public/); la página de prueba
      // la sirve `pnpm prueba`. verificar.ts es la casilla de Turnstile del SDK (verificar.html).
      "entry": ["src/main.tsx", "src/verificar.ts", "public/v1/embed.js", "test/**/*.test.{ts,tsx}", "test/setup.ts"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "public/**/*.js", "*.config.ts"],
      // Tailwind y los tokens se importan en estilos.css; Konva lo usa @tpv/plano por debajo.
      "ignoreDependencies": ["tailwindcss", "@tpv/estilos", "react-konva"]
    },
    "packages/reservas-web-sdk": {
      // Lo que se publica en npm: la entrada y la de los tipos, que importa también el worker.
      "entry": ["src/index.ts", "src/tipos.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "*.config.ts"]
    },
    "packages/plano": {
      "entry": ["src/index.ts", "src/geometria.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/cloud-worker-licensing": {
      // No ejecutar cloudflareTest al analizar: inicializa el pool nativo de workerd.
      "vitest": false,
      // cloudflare:workers y cloudflare:test son módulos del runtime, no paquetes npm.
      "ignoreDependencies": ["cloudflare"],
      "entry": ["src/index.ts", "vitest.config.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "*.config.ts"]
    },
    "packages/client": {
      "entry": ["src/index.ts", "src/generated/metadata.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/database": {
      "entry": [],
      "project": []
    }
  }
}
