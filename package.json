{
  "name": "tpv-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "description": "Monorepo TPV — apps (Tauri desktop + Cloudflare Workers), crates Rust hexagonales y packages JS compartidos.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "generate-types": "turbo run generate-types",
    "tauri": "pnpm --filter @tpv/main tauri",
    "license:issue": "node scripts/tpv-license.mjs issue",
    "license:list": "node scripts/tpv-license.mjs list",
    "license:revoke": "node scripts/tpv-license.mjs revoke",
    "license:unrevoke": "node scripts/tpv-license.mjs unrevoke",
    "license:extend": "node scripts/tpv-license.mjs extend",
    "license:shorten": "node scripts/tpv-license.mjs shorten",
    "license:resend": "node scripts/tpv-license.mjs resend",
    "license:keypair": "node scripts/generate-license-keypair.mjs",
    "verifactu:validar-xml": "python scripts/verifactu-validar-xml.py",
    "verifactu:certificados": "cargo run -q -p tpv-infra-aeat --example certificados",
    "verifactu:probar-aeat": "cargo run -q -p tpv-infra-aeat --example probar_aeat",
    "verifactu:ciclo": "cargo run -q -p tpv-infra-aeat --example ciclo_completo",
    "verifactu:experimento": "cargo run -q -p tpv-infra-aeat --example experimento_cadena"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "engines": {
    "node": ">=18"
  }
}
