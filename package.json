{
  "name": "tpv-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "description": "Monorepo TPV — apps (Tauri desktop + Cloudflare Workers), crates Rust hexagonales y packages JS compartidos.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "generate-types": "turbo run generate-types",
    "generate-types:check": "node scripts/generate-types.mjs --check",
    "tauri": "pnpm --filter @tpv/main tauri",
    "license:issue": "node scripts/tpv-license.mjs issue",
    "license:list": "node scripts/tpv-license.mjs list",
    "license:revoke": "node scripts/tpv-license.mjs revoke",
    "license:unrevoke": "node scripts/tpv-license.mjs unrevoke",
    "license:extend": "node scripts/tpv-license.mjs extend",
    "license:shorten": "node scripts/tpv-license.mjs shorten",
    "license:resend": "node scripts/tpv-license.mjs resend",
    "license:recifrar": "node scripts/tpv-license.mjs recifrar",
    "license:keypair": "node scripts/generate-license-keypair.mjs",
    "interruptor:apagar": "node scripts/tpv-license.mjs interruptor-apagar",
    "interruptor:encender": "node scripts/tpv-license.mjs interruptor-encender",
    "interruptor:lista": "node scripts/tpv-license.mjs interruptor-lista",
    "piloto:poner": "node scripts/tpv-license.mjs piloto-poner",
    "piloto:quitar": "node scripts/tpv-license.mjs piloto-quitar",
    "piloto:lista": "node scripts/tpv-license.mjs piloto-lista",
    "reservas-web:ver": "node scripts/tpv-license.mjs reservas-web-ver",
    "reservas-web:dominio-poner": "node scripts/tpv-license.mjs reservas-web-dominio-poner",
    "reservas-web:dominio-quitar": "node scripts/tpv-license.mjs reservas-web-dominio-quitar",
    "reservas-web:revocar-clave": "node scripts/tpv-license.mjs reservas-web-revocar-clave",
    "release:lista": "node scripts/tpv-license.mjs release-lista",
    "release:promocionar": "node scripts/tpv-license.mjs release-promocionar",
    "verifactu:validar-xml": "python scripts/verifactu-validar-xml.py",
    "verifactu:certificados": "cargo run -q -p tpv-infra-aeat --example certificados",
    "verifactu:probar-aeat": "cargo run -q -p tpv-infra-aeat --example probar_aeat",
    "verifactu:ciclo": "cargo run -q -p tpv-infra-aeat --example ciclo_completo",
    "verifactu:devoluciones": "cargo run -q -p tpv-infra-aeat --example devoluciones",
    "verifactu:experimento": "cargo run -q -p tpv-infra-aeat --example experimento_cadena",
    "verifactu:errores": "cargo run -q -p tpv-infra-aeat --example errores_esperados",
    "verifactu:limites": "cargo run -q --release -p tpv-infra-aeat --example lote_y_subsanacion"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "knip": "6.41.0",
    "turbo": "^2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
