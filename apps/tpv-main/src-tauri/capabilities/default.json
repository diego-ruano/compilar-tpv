{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": ["main"],
    "permissions": [
        "core:default",

        "core:window:allow-minimize",
        "core:window:allow-toggle-maximize",
        "core:window:allow-close",
        "core:window:allow-start-dragging",
        "core:window:allow-set-background-color",

        "dialog:default",

        {
            "identifier": "fs:allow-write-file",
            "deny": [
                { "path": "$APPDATA/data.db" },
                { "path": "$APPDATA/data.db-wal" },
                { "path": "$APPDATA/data.db-shm" },
                { "path": "$APPDATA/data.db.bak.*" },
                { "path": "$APPDATA/device_config.json" },
                { "path": "$APPDATA/license_state.json" },
                { "path": "$APPDATA/traslado-pendiente" },
                { "path": "$APPDATA/anterior-a-la-nube" },
                { "path": "$APPDATA/cambio-de-negocio" },
                { "path": "$APPDATA/cambio-de-negocio.tmp" },
                { "path": "$APPDATA/license_state.pending.json" },
                { "path": "$APPDATA/license_state.pending.json.tmp" },
                { "path": "$APPDATA/interruptores.json" },
                { "path": "$APPDATA/backups/**" },
                { "path": "$APPDATA/image_uploads.json" },
                { "path": "$APPDATA/image_uploads.json.tmp" },
                { "path": "$APPDATA/telemetry-spool/**" },
                { "path": "$APPDATA/logs/**" },
                { "path": "$APPDATA/image_backfill_done" },
                { "path": "$APPDATA/facturas/**" }
            ]
        }
    ]
}
