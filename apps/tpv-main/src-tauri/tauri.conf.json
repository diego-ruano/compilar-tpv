{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tpv",
  "version": "0.1.0",
  "identifier": "com.altarialights.tpv",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tpv",
        "width": 800,
        "height": 600,
        "decorations": false,
        "label": "main",
        "backgroundColor": "#f6f7f9"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: https:; connect-src 'self' ipc: https: wss: ws:; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCM0JBRTNGQjdDOUUxRDEKUldUUjRjbTNQNjQ3VzZLUXc0eWd5RmhZYlFpQXRWYjRvdmEwT29QcDBBYjRTQjZ1RWw1U01vb1YK",
      "endpoints": [
        "https://tpv-api.altarialights.workers.dev/v1/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}