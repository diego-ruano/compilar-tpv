{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TPV - Altaria Lights",
  "version": "0.1.0",
  "identifier": "com.altarialights.tpv",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tpv",
        "width": 800,
        "height": 600,
        "decorations": false,
        "label": "main",
        "backgroundColor": "#f3f8ff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost https://pub-6814391221e444b8b1747ab67ce3c21f.r2.dev blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws:; img-src 'self' asset: http://asset.localhost https://asset.localhost https://pub-6814391221e444b8b1747ab67ce3c21f.r2.dev blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Altaria Lights",
    "copyright": "© 2026 Altaria Lights",
    "homepage": "https://altarialights.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Spanish"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "windows/instalador-lateral.bmp",
        "headerImage": "windows/instalador-cabecera.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCM0JBRTNGQjdDOUUxRDEKUldUUjRjbTNQNjQ3VzZLUXc0eWd5RmhZYlFpQXRWYjRvdmEwT29QcDBBYjRTQjZ1RWw1U01vb1YK",
      "endpoints": [
        "https://tpv-api.altarialights.workers.dev/v1/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
