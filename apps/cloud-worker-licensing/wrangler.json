{
	"name": "tpv-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"routes": [
		{
			"pattern": "tpv-api.altarialights.com",
			"custom_domain": true
		},
		{
			"pattern": "reservas-tpv.altarialights.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"logpush": true,
	"upload_source_maps": true,
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.sql"
			],
			"fallthrough": true
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"TenantHub"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"AgendaWeb"
			]
		}
	],
	"ratelimits": [
		{
			"name": "LIMITADOR_CLAIM",
			"namespace_id": "1",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "LIMITADOR_LICENCIA",
			"namespace_id": "2",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "LIMITADOR_RESERVA_WEB",
			"namespace_id": "3",
			"simple": {
				"limit": 120,
				"period": 60
			}
		},
		{
			"name": "LIMITADOR_RESERVA_WEB_ALTA",
			"namespace_id": "4",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "TenantHub",
				"name": "TenantHub"
			},
			{
				"class_name": "AgendaWeb",
				"name": "AgendaWeb"
			}
		]
	},
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "tpv-images"
		},
		{
			"binding": "COPIAS",
			"bucket_name": "tpv-copias-control"
		}
	],
	"triggers": {
		"crons": [
			"0 7 * * *"
		]
	},
	"vars": {
		"TURSO_DATABASE_URL": "libsql://tpvcontrol-altarialights.aws-eu-west-1.turso.io",
		"TURSO_ORG_SLUG": "altarialights",
		"EMAIL_FROM_ADDRESS": "pedidos@altarialights.com",
		"EMAIL_FROM_NAME": "TPV",
		"EMAIL_RESERVAS_FROM_ADDRESS": "reservas@altarialights.com",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFZhNrJzycaxI4_h",
		"RESERVAS_WEB_ORIGEN": "https://reservas-tpv.altarialights.com",
		"AXIOM_DATASET": "tpv-device-logs",
		"AXIOM_DATASET_SYNC": "tpv-sync",
		"AXIOM_DOMAIN": "eu-central-1.aws.edge.axiom.co"
	},
	"assets": {
		"directory": "../reservas-web/dist",
		"binding": "ASSETS",
		"html_handling": "none",
		"not_found_handling": "none",
		"run_worker_first": true
	}
}
