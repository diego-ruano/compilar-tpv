{
	"name": "tpv-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.sql"
			],
			"fallthrough": true
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"TenantHub"
			]
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "TenantHub",
				"name": "TenantHub"
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "tpv-images"
		},
		{
			"bucket_name": "tpv-images",
			"binding": "tpv_images",
			"remote": true
		}
	],
	"vars": {
		"TURSO_DATABASE_URL": "libsql://tpvcontrol-altarialights.aws-eu-west-1.turso.io",
		"TURSO_ORG_SLUG": "altarialights"
	}
}