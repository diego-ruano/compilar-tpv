{
	"name": "tpv-api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @tpv/reservas-web build && wrangler dev",
		"desplegar": "pnpm --filter @tpv/reservas-web build && wrangler deploy",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"cf-typegen": "wrangler types ./src/server/worker-configuration.d.ts"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.1",
		"@libsql/client": "^0.18.0",
		"@sentry/cloudflare": "^10.78.0",
		"@tpv/contracts": "workspace:*",
		"hono": "^4.13.19",
		"jose": "^6.2.18",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@altarialights/reservas-web-tpv": "workspace:*",
		"@cloudflare/vitest-pool-workers": "^0.23.0",
		"@noble/ed25519": "^3.2.0",
		"@sentry/cli": "2.58.6",
		"typescript": "catalog:",
		"vitest": "^4.1.10",
		"wrangler": "^4.165.0"
	}
